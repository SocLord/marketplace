@startuml activity-order
title Раванди расмийяткунӣ ва иҷрои фармоиш (Order Fulfillment)

|Харидор (Buyer)|
start
repeat
  :Пур кардани маълумот (суроға, телефон);
  :Пахш кардани тугмаи "Расмӣ кардан";
  repeat while (Маълумот нодуруст аст?) is (ҳа)
    :Нишон додани хатогӣ;
  not(не)

|Система (System)|
  :Эҷоди Order (status='processing');
  :Гурӯҳбандӣ аз рӯи ShopID ва \nэҷоди SubOrder (status='pending');
  :Захира кардани OrderItem;

|Фурӯшанда (Seller)|
  :Дидани фармоиши нав дар кабинет;
  if (Мол дар анбор мавҷуд аст?) then (ҳа)
    :Иваз кардани статуси SubOrder ба 'processing';
  else (не)
    :Иваз кардани статус ба 'cancelled';
    stop
  endif

|Курйер (Courier)|
  :Гирифтани мол аз фурӯшанда;
  :Иваз кардани статус ба 'shipped';
  :Расонидан ба харидор;
  
  if (Харидор молро қабул кард?) then (ҳа)
    |Система (System)|
      :Иваз кардани статуси SubOrder ба 'delivered';
      :Фаъол кардани имконияти гузоштани шарҳ;
    |Харидор (Buyer)|
      :Гузоштани шарҳ ва баҳо (Review);
    stop
  else (не, даст кашид)
    |Курйер (Courier)|
      :Баргардонидани мол;
      :Иваз кардани статус ба 'cancelled';
    stop
  endif

@enduml