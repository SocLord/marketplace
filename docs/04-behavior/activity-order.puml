@startuml activity-order
title Процесс оформления и выполнения заказа (Order Fulfillment)

|Покупатель (Buyer)|
start
repeat
  :Заполнить данные (адрес, телефон);
  :Нажать кнопку "Оформить";
repeat while (Данные некорректны?) is (да)

|Система (System)|
  :Показать ошибку валидации;

|Покупатель (Buyer)|
  :Исправить данные и повторить;

|Система (System)|
  :Создать Order (status='processing');
  :Сгруппировать по ShopID и \nсоздать SubOrder (status='pending');
  :Сохранить OrderItem;

|Продавец (Seller)|
  :Увидеть новый заказ в кабинете;
  if (Товар есть на складе?) then (да)
    :Изменить статус SubOrder на 'processing';
  else (нет)
    :Изменить статус на 'cancelled';
    stop
  endif

|Курьер (Courier)|
  :Забрать товар у продавца;
  :Изменить статус на 'shipped';
  :Доставить покупателю;
  
  if (Покупатель принял товар?) then (да)
    |Система (System)|
      :Изменить статус SubOrder на 'delivered';
      :Разрешить оставить отзыв;
    |Покупатель (Buyer)|
      :Оставить отзыв и оценку (Review);
    stop
  else (нет, отказ)
    |Курьер (Courier)|
      :Вернуть товар;
      :Изменить статус на 'cancelled';
    stop
  endif

@enduml