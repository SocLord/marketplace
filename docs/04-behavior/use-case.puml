@startuml use-case
left to right direction
title Маркетплейс: Диаграмма вариантов использования (Use Case)

actor "Покупатель\n(buyer)" as Buyer
actor "Продавец\n(seller)" as Seller
actor "Модератор\n(moderator)" as Moderator
actor "Администратор\n(admin)" as Admin

rectangle "marketplace" {
  usecase "Войти в систему" as UC1
  usecase "Найти и отфильтровать товары" as UC2
  usecase "Добавить товар в корзину" as UC3
  usecase "Оформить заказ" as UC4
  usecase "Проверить наличие товаров" as UC5
  usecase "Создать и редактировать карточку товара" as UC6
  usecase "Провести модерацию товара" as UC7
  usecase "Отклонить товар с комментарием" as UC8
  usecase "Изменить статус подзаказа" as UC9
  usecase "Оставить отзыв и оценку" as UC10
  usecase "Управлять категориями" as UC11
}

' Связи акторов с вариантами использования
Buyer --> UC1
Buyer --> UC2
Buyer --> UC3
Buyer --> UC4
Buyer --> UC10

Seller --> UC1
Seller --> UC6
Seller --> UC9

Moderator --> UC1
Moderator --> UC7

Admin --> UC1
Admin --> UC11

' Отношения include и extend
UC4 ..> UC5 : <<include>>
UC8 ..> UC7 : <<extend>>
UC10 ..> UC4 : <<extend>>

note right of UC4
  ФТ-06: Оформление заказа
  включает проверку остатков (UC5)
end note

note right of UC8
  ФТ-03: Модерация
  расширяется отклонением с комментарием
end note

@enduml